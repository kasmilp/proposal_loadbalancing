# Salin menjadi .env lalu isi. Jangan commit .env.
ROS_HOST=id-23.hostddns.us
ROS_PORT=6187
ROS_USER=monitoring123
ROS_PASS=GANTI_PASSWORD

# Label lokasi/perangkat
SITE_LABEL=rt-rw-net-buru
ROUTER_LABEL=rb1100ahx4

# Interval (detik)
INTERVAL_RESOURCE=10
INTERVAL_INTERFACE=10
INTERVAL_ROUTE=60
INTERVAL_MANGLE=60
INTERVAL_SERVICE=3600
INTERVAL_PROBE=2

# Probe per WAN: interface yang dipakai router untuk ping
PROBE_INTERFACES=ether1-ISP-A,ether2-ISP-B,ether3-ISP-C
PROBE_TARGETS=1.1.1.1,8.8.8.8

# Durasi default (0 = tanpa batas). Contoh: 7d, 24h, 3600s
DURATION=0

# Opsional: aktifkan pembacaan tabel koneksi (bisa timeout)
READ_CONNECTIONS=false
